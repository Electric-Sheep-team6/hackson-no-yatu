# ============================================
# Supabase
# ============================================

# Supabase プロジェクトの URL。
# Supabase Dashboard の Project Settings > API から取得します。
# NEXT_PUBLIC_ が付いているため、ブラウザ側から参照されます。
NEXT_PUBLIC_SUPABASE_URL=

# Supabase の公開用 Anon Key。
# ブラウザから利用する前提のキーですが、
# Row Level Security（RLS）を必ず適切に設定してください。
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Supabase の Service Role Key。
# RLS を回避できる非常に強い権限を持つ秘密鍵です。
# 絶対にブラウザ側へ公開せず、サーバー側でのみ使用してください。
SUPABASE_SERVICE_ROLE_KEY=

# ============================================
# AI API
# ============================================

# OpenAI API の API キー。
# AI_TEXT_PROVIDER=openai のときにテキスト生成で使用します。
# サーバー側でのみ使用し、クライアントへ公開しないでください。
OPENAI_API_KEY=

# Google Gemini API の API キー。
# Gemini による動画生成、および
# AI_TEXT_PROVIDER=gemini のときのテキスト生成で使用します。
# 動画生成には課金が有効なプロジェクトのキーが必要です。
# 無料枠では動画生成のクォータが 0 のため必ず 429 になります。
GEMINI_API_KEY=

# テキスト生成に使用する AI プロバイダー。
# 指定できる値は "openai" または "gemini" です。
# 未設定の場合は "openai" として動作します。
AI_TEXT_PROVIDER=openai

# ============================================
# FFmpeg
# ============================================

# 使用する FFmpeg バイナリのパス。
# 通常は ffmpeg-static のバイナリが自動的に使われるため設定不要です。
# 独自のバイナリを使う場合だけ設定してください。
# 例: FFMPEG_PATH=/usr/local/bin/ffmpeg
FFMPEG_PATH=
